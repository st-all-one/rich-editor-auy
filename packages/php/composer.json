{
  "name": "rich-editor-auy/php",
  "description": "Thin PHP transport for canonical rich-editor-auy envelopes",
  "type": "library",
  "license": "MIT OR Apache-2.0",
  "require": {
    "php": ">=8.3",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": { "RichEditorAuy\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "RichEditorAuy\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
